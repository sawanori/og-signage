{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "og-company-research",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "RESEARCH_PAID_ENABLED": "true", "RESEARCH_CANARY_SOURCE_IDS": "" },
  "r2_buckets": [{ "binding": "RESEARCH_BUCKET", "bucket_name": "og-company-research-private" }],
  "triggers": { "crons": ["* * * * *"] }
}
