{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharehouse-signage",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "vars": {
    // 掲載結果メールの差出人。ブランド名（WeWork）を別ドメインから名乗るとなりすましと見られ迷惑メールに入るため変えた（2026-10-01 ユーザー指示）
    "SPOTLIGHT_NOTIFICATION_FROM": "サイネージ管理 <noreply@non-turn.com>",
    // 管理画面の「企業データ」を見られるアカウント（ログインのメールアドレス。カンマ区切り。2026-10-02 ユーザー指示）
    "COMPANY_RESEARCH_VIEWER_EMAILS": "snp.inc.info@gmail.com",
    // メンバー相談チャット（/chat）を使えるアカウント（ログインのメールアドレス。カンマ区切り。2026-10-05 試験運用）
    "COMPANY_CHAT_EMAILS": "snp.inc.info@gmail.com"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  // 画像・動画の保存先（実ファイル）。メタデータは Turso に置く。
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sharehouse-signage"
    }
  ],

  // 分析結果を読むAPIはない。保存済みのURLイベントだけを非公開Workerへ配送する。
  "services": [
    { "binding": "COMPANY_RESEARCH", "service": "og-company-research" }
  ],

  // 分析イベントは保存成功後にバックグラウンド配送し、未配送分は既存の30分Cronでも再送する。
  // 天気・掲載結果メール再送は30分ごと、既存の掃除は日次を維持。
  // scheduled ハンドラは worker/index.ts の scheduled から worker/scheduled.ts を呼ぶ。
  // "0 19 * * *" は日本時間 4:00（Pi の Chromium 毎日再起動と同じ時間帯。計画 7 節）。
  "triggers": {
    "crons": ["*/30 * * * *", "0 19 * * *"]
  },

  // Rate Limiting binding（ログインの IP / メールアドレス単位、lib/rate-limit.ts）。
  // マシンごとの概算で厳密な回数制限ではない（docs/spikes/workers.md 7 節）。同じメールの連続失敗は DB でも止める。
  // namespace_id はアカウント内で一意の整数文字列（検証用 Worker は 4201 を使った）。
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "4301",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SPOTLIGHT_SUBMISSION_RATE_LIMITER",
      "namespace_id": "4302",
      // 施設のWi-Fiを共有するメンバーが受付のQRから同時に送れるよう、1回線あたり60秒20回（2026-10-01）
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // 名刺の読み取り（Gemini の従量課金。1回約0.2円）。本人登録の送信と同じく、施設のWi-Fiを共有する
      // メンバーが受付で続けて使えるよう1回線あたり60秒20回
      "name": "BUSINESS_CARD_RATE_LIMITER",
      "namespace_id": "4303",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // メンバー相談チャット（Gemini の従量課金）。1アカウントあたり 60 秒に 20 回まで
      "name": "COMPANY_CHAT_RATE_LIMITER",
      "namespace_id": "4304",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
